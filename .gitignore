# ---- ShineTV Studio .gitignore ----

# 本地打包/运行时/索引（不提交）
/dist/
/runtime/
/.codegraph/

# 构建输出（不提交二进制与中间文件）
/build/
/build-release/
/build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
*.exe
*.pdb
*.obj
*.o
*.a
*.lib
*.dll
*.ilk
*.exp
*.idb
*.so
*.dylib
*.out
*.app

# 日志与临时报告
*.log
libhv*.log
*_check.txt
*check*.txt
**/mcp_selfcheck*
**/mcp_http_check*
%TEMP%/

# 运行时本地状态（各人机器不同）
*.ini
!**/CMake*.ini

# IDE / 工具目录
.vs/
.vscode/
.idea/
.clice/
.codebuddy/
.clangd/
compile_commands.json

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 原 UE 插件：只保留源码，不提交编译产物
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/
Plugins/**/*.pdb
Plugins/**/*.exe
Plugins/**/*.dll
Plugins/**/*.lib
Plugins/**/*.obj

# 第三方：只提交源码，不提交其构建目录
third/**/build/
third/**/Build/
third/**/*.o
third/**/*.a
third/**/*.lib
third/**/*.exe
third/**/*.pdb

# 本地预览/草稿页面与杂项
novel-*-preview.html
*.tmp
*.bak
*~

# 取证产物（out/ 下的**输入**在版本控制里，输出不进）
#
# out/_fixture_{schema,data,seed}.sql + out/_{make_fixture,run_review}.ps1 是提交的 ——
# 它们定义了**验证条件**：novel.db fixture 的内容就是那 78 张截图的前提，不提交
# 别人无法复现同一组取证。重建后的库与每一轮的截图都是产物。
/out/_fixture/
/out/review-*/
/out/*.stdout.txt

# MiMo / 本地会话
.mimocode/node_modules/
.mimocode/*.log
.mimocode/cache/
.mimocode/tmp/
.mimocode/*.db
.mimocode/*.sqlite*

# React 设计稿（仅作视觉参照，不进版本库；其 node_modules 体积很大）
webui/
.zcodeignore
