#ifndef SHINE_TEXTURE_NODE_LERP_USH
#define SHINE_TEXTURE_NODE_LERP_USH

// Param packing contract:
// Param0: unused
// Param1: unused

float4 ShineTexture_EvaluateLerp(
    Texture2D<float4> InputTextureA,
    Texture2D<float4> InputTextureB,
    Texture2D<float4> InputTextureAlpha,
    SamplerState InputSampler,
    int3 InputValid,
    float2 UV)
{
    float4 A = ShineTexture_SampleOrDefault(InputTextureA, InputSampler, InputValid.x != 0, UV, 0.0);
    float4 B = ShineTexture_SampleOrDefault(InputTextureB, InputSampler, InputValid.y != 0, UV, 0.0);
    float Alpha = ShineTexture_SampleOrDefault(InputTextureAlpha, InputSampler, InputValid.z != 0, UV, 0.0).r;
    return lerp(A, B, Alpha);
}

#endif
