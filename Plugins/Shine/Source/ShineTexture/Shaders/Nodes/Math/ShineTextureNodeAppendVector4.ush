#ifndef SHINE_TEXTURE_NODE_APPEND_VECTOR4_USH
#define SHINE_TEXTURE_NODE_APPEND_VECTOR4_USH

// Param packing contract:
// Param0: unused
// Param1: unused

float4 ShineTexture_EvaluateAppendVector4(
    Texture2D<float4> InputTextureX,
    Texture2D<float4> InputTextureY,
    Texture2D<float4> InputTextureZ,
    Texture2D<float4> InputTextureW,
    SamplerState InputSampler,
    int4 InputValid,
    float2 UV)
{
    float ValueX = ShineTexture_SampleOrDefault(InputTextureX, InputSampler, InputValid.x != 0, UV, 0.0).r;
    float ValueY = ShineTexture_SampleOrDefault(InputTextureY, InputSampler, InputValid.y != 0, UV, 0.0).r;
    float ValueZ = ShineTexture_SampleOrDefault(InputTextureZ, InputSampler, InputValid.z != 0, UV, 0.0).r;
    float ValueW = ShineTexture_SampleOrDefault(InputTextureW, InputSampler, InputValid.w != 0, UV, 0.0).r;
    return float4(ValueX, ValueY, ValueZ, ValueW);
}

#endif
