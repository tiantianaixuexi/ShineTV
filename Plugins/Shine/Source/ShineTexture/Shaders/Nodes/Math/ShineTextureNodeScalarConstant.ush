#ifndef SHINE_TEXTURE_NODE_SCALAR_CONSTANT_USH
#define SHINE_TEXTURE_NODE_SCALAR_CONSTANT_USH

// Param packing contract:
// Param0: x=Value, y=unused, z=unused, w=unused
// Param1: unused

float4 ShineTexture_EvaluateScalarConstant(float4 Param0)
{
    return float4(Param0.x, Param0.x, Param0.x, 1.0);
}

#endif
