#ifndef SHINE_TEXTURE_NODE_EQUAL_USH
#define SHINE_TEXTURE_NODE_EQUAL_USH

// Param packing contract:
// Param0: x=Epsilon, y=unused, z=unused, w=unused
// Param1: unused

float4 ShineTexture_EvaluateEqual(
    Texture2D<float4> InputTextureA,
    Texture2D<float4> InputTextureB,
    SamplerState InputSampler,
    int2 InputValid,
    float2 UV,
    float4 Param0)
{
    float ValueA = ShineTexture_SampleOrDefault(InputTextureA, InputSampler, InputValid.x != 0, UV, 0.0).r;
    float ValueB = ShineTexture_SampleOrDefault(InputTextureB, InputSampler, InputValid.y != 0, UV, 0.0).r;
    float Result = abs(ValueA - ValueB) <= max(Param0.x, 0.000001) ? 1.0 : 0.0;
    return float4(Result, Result, Result, 1.0);
}

#endif
